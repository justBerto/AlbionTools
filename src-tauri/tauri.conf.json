{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlbionTools",
  "version": "0.1.1",
  "identifier": "com.albiontools.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AlbionTools — Companion & Telemetry Suite",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "decorations": true
      },
      {
        "label": "overlay",
        "title": "AlbionTools DPS Meter",
        "url": "/?overlay=true",
        "width": 360,
        "height": 340,
        "minWidth": 280,
        "minHeight": 200,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true
      }
    }
  }
}
